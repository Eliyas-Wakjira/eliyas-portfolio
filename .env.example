# Administrator email used by the backend sign-in endpoint.
ADMIN_EMAIL=""

# Format: 32-character hex salt, colon, 128-character scrypt hash.
# Generate it using the instructions in README.md. Never commit real credentials.
ADMIN_PASSWORD_HASH=""

# Random session signing secret; at least 32 bytes.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
AUTH_TOKEN_SECRET=""

# Frontend URL(s) allowed to call the API, comma-separated.
# Example: https://portfolio.example.com
FRONTEND_ORIGINS=""

# Set while building the standalone frontend to the backend origin only.
# Example: https://api.example.com
VITE_API_URL=""

# MySQL 8 connection used by the backend. The database and tables are created
# automatically at startup; MYSQL_USER must be able to create databases.
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_DATABASE="eliyas_portfolio"
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_CONNECTION_LIMIT="10"
